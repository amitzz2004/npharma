{
  "name": "pharma-backend",
  "version": "1.0.0",
  "description": "Backend API for Pharma Company website - Contact & Quotation forms with Nodemailer",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
